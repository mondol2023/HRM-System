# Copy to .env and fill in real values. Never commit .env.

# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=debug
CLIENT_URL=http://localhost:5173
# Proxy hops in front of this process (nginx/ALB=1). Wrong value lets req.ip be spoofed.
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=15000
# 0 = one process per CPU core (src/cluster.ts)
CLUSTER_WORKERS=0

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hrm-system
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5
MONGO_AUTO_INDEX=false

# ─── Redis (cache, rate limiting, job queue) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=hrm

# ─── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
COOKIE_SECRET=replace-with-a-third-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict
BCRYPT_ROUNDS=12

# ─── Rate limiting ───────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW=1m
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1m

# ─── Cache TTLs (seconds) ────────────────────────────────
CACHE_TTL_LIST=60
CACHE_TTL_ENTITY=300
CACHE_TTL_STATS=60

# ─── OpenAI (resume parsing, sentiment, attrition) ──────
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
RESUME_MAX_BYTES=5242880

# ─── Background worker ───────────────────────────────────
# true only for single-process local dev; production runs `npm run start:worker` separately.
RUN_WORKER_IN_API=true
WORKER_SENTIMENT_CONCURRENCY=5
WORKER_ATTRITION_CONCURRENCY=3

# ─── Seed script (npm run seed) ──────────────────────────
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@hrm.local
ADMIN_PASSWORD=Admin@12345
